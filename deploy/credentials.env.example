# Protect the real file with root:desk ownership and mode 0640.
# PAT for initial discovery; recently issued PATs expire in 24 hours.
SMARTTHINGS_TOKEN=
# Matching OAuth-In App client credentials, required to connect and refresh:
# Set before Connect to SmartThings; the app creates the token file itself.
# Restart desk-web, desk-https (if installed), and the listener (if running)
# after changing these values. A project .env is not automatically loaded.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# HTTPS certificates use manual TXT records in Lightsail; no AWS credentials needed.
