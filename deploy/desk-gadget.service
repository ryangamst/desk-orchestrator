[Unit]
Description=Desk USB keyboard gadget
Before=desk-orchestrator.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/desk-orchestrator/deploy/setup-gadget.sh start
ExecStop=/bin/bash /opt/desk-orchestrator/deploy/setup-gadget.sh stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
